# Server
PORT=4000
NODE_ENV=development

# ML Team's API (simulator + model), as given to you by the ML team
ML_API_BASE_URL=http://localhost:8000
USE_MOCK_ML=false
ML_API_TIMEOUT_MS=5000

# SQLite DB file path
DB_PATH=./data/ew_scheduler.db

